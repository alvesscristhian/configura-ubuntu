{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // "chafa" desenha a foto com blocos Unicode coloridos e funciona em QUALQUER
  // terminal (Ptyxis, GNOME Console, etc). O .zshrc troca para "kitty-direct"
  // automaticamente quando o terminal e o kitty, que aí mostra a foto nitida.
  // Troque a foto com o comando "set-fetch-photo".
  //
  // width/height sao em CELULAS do terminal, nao pixels -- e essa e a unica
  // forma real de tirar o pixelado do chafa: mais celulas = mais resolucao.
  // Cada celula rende 2 meio-blocos verticais, entao 30x20 da ~30x40 "pixels"
  // contra os ~16x22 de antes. Aumente mais se ainda estiver grosseiro.
  // Para nao distorcer: altura = largura * (h/w da foto) / 2.
  // Esta foto e 960x1280, entao altura = largura * 0,67 -> 30 colunas = 20 linhas.
  "logo": {
    "type": "chafa",
    "source": "/home/cristhian/.config/fastfetch/logo.png",
    "width": 30,
    "height": 20,
    "preserveAspectRatio": true,
    // Estas opcoes ficam ANINHADAS aqui dentro; como chaves soltas em "logo"
    // o fastfetch rejeita com "Unknown logo key".
    "chafa": {
      // Mais formas de caractere = bordas mais finas (so blocos = mais grosseiro)
      "symbols": "block+border+space+diagonal+dot",
      "canvasMode": "TRUECOLOR",
      "colorSpace": "DIN99D",
      "ditherMode": "NONE"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },

  "display": {
    "separator": "  "
  },

  // Só o essencial. Para voltar algo, descomente:
  //   "packages", "terminalfont", "de", "wm", "display",
  //   "gpu", "swap", "localip", "battery"
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "uptime",
    "shell",
    "terminal",
    "cpu",
    "memory",
    "disk",
    "break",
    "colors"
  ]
}
